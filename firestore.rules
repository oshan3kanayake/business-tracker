rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && exists(currentUserPath());
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    function currentRole() {
      return currentUserExists() ? currentUser().role : null;
    }

    function currentHotelId() {
      return currentUserExists() ? currentUser().hotelId : null;
    }

    function isOwner() {
      return currentRole() == "owner";
    }

    function isManager() {
      return currentRole() == "manager";
    }

    function isStaff() {
      return currentRole() == "staff";
    }

    function isManagerOrStaff() {
      return isManager() || isStaff();
    }

    function sameHotel(hotelId) {
      return isManagerOrStaff()
        && currentHotelId() != null
        && hotelId == currentHotelId();
    }

    function sameIncomingHotel(hotelId) {
      return sameHotel(hotelId);
    }

    function hotelIdUnchanged() {
      return resource.data.hotelId == request.resource.data.hotelId;
    }

    function hotelManagerExists(hotelId) {
      return hotelId is string
        && exists(/databases/$(database)/documents/users/$(hotelId))
        && get(/databases/$(database)/documents/users/$(hotelId)).data.role == "manager";
    }

    // --- R02 FIX ------------------------------------------------------------
    // Old behaviour: an Owner could access ANY hotel simply because a manager
    // document existed for it. With more than one Owner that exposes every
    // hotel to every Owner (cross-tenant leak).
    //
    // Current data model: there is a SINGLE owner who owns all hotels, and a
    // "hotel" is a manager users/{uid} document. There is no ownerId field
    // linking a hotel to a specific owner yet. So the correct, honest rule
    // today is: the owner may access a hotel only if that hotel is a real
    // manager hotel (unchanged) AND the caller is the owner. This still means
    // "the one owner can read all hotels", which matches the product today.
    //
    // TODO (before adding a SECOND owner): add an `ownerId` field on each hotel
    // (or a hotelIds list on the owner's users doc) and replace the body below
    // with an ownership check, e.g.:
    //   get(/databases/$(database)/documents/users/$(hotelId)).data.ownerId
    //     == request.auth.uid
    function ownerCanAccessHotel(hotelId) {
      return isOwner() && hotelManagerExists(hotelId);
    }
    // -----------------------------------------------------------------------

    function canReadHotel(hotelId) {
      return sameHotel(hotelId) || ownerCanAccessHotel(hotelId);
    }

    function canCreateHotelDocument() {
      return isManagerOrStaff()
        && sameIncomingHotel(request.resource.data.hotelId);
    }

    function canUpdateHotelDocument() {
      return isManagerOrStaff()
        && sameHotel(resource.data.hotelId)
        && sameIncomingHotel(request.resource.data.hotelId)
        && hotelIdUnchanged();
    }

    function canDeleteHotelDocument() {
      return isManagerOrStaff() && sameHotel(resource.data.hotelId);
    }

    function linkedBooking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function validStaffBookingIncome(data) {
      return isStaff()
        && data.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(data.bookingId))
        && linkedBooking(data.bookingId).hotelId == currentHotelId()
        && linkedBooking(data.bookingId).paymentStatus == "paid"
        && data.hotelId == linkedBooking(data.bookingId).hotelId
        && data.source == "Room Revenue - Booking"
        && data.isAutoGenerated == true
        && data.amount == linkedBooking(data.bookingId).totalAmount
        && data.date == linkedBooking(data.bookingId).checkIn;
    }

    function staffCanDeleteBookingIncome() {
      return isStaff()
        && resource.data.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
        && linkedBooking(resource.data.bookingId).hotelId == currentHotelId()
        && resource.data.hotelId == currentHotelId();
    }

    // --- B03 FIX (restaurant income) ---------------------------------------
    // Saving a paid restaurant order writes an accompanying income document in
    // the same batch (source: "Restaurant", isAutoGenerated: true). Allow a
    // Manager or Staff of the SAME hotel to write that income doc, scoped to
    // their hotel. This is what unblocks the restaurant save (the batch was
    // failing on the income write, not the restaurantOrders write).
    function validRestaurantIncome(data) {
      return isManagerOrStaff()
        && data.hotelId == currentHotelId()
        && data.source == "Restaurant"
        && data.isAutoGenerated == true
        && data.restaurantOrderId is string;
    }

    function staffOrManagerCanDeleteRestaurantIncome() {
      return isManagerOrStaff()
        && resource.data.hotelId == currentHotelId()
        && resource.data.source == "Restaurant";
    }
    // -----------------------------------------------------------------------

    match /users/{userId} {
      allow get: if currentUserExists()
        && (
          request.auth.uid == userId
          || isOwner()
        );

      allow list: if isOwner();

      // Manager signup must move to a trusted backend. Allowing a new
      // browser-authenticated user to create role: "manager" would permit
      // self-promotion.
      allow create: if false;

      allow update: if currentUserExists()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get("hotelId", null)
          == resource.data.get("hotelId", null);

      allow delete: if false;
    }

    match /hotels/{hotelId} {
      allow read: if canReadHotel(hotelId);
      allow write: if false;
    }

    // --- B04 FIX ------------------------------------------------------------
    // Owner is allowed to add/edit/delete packages (product decision), in
    // addition to the Manager. Previously only Manager writes were permitted,
    // so the owner-packages.html create/update/delete returned 403.
    match /packages/{documentId} {
      allow read: if canReadHotel(resource.data.hotelId);

      allow create: if (
          isManager()
          && sameIncomingHotel(request.resource.data.hotelId)
        ) || (
          isOwner()
          && ownerCanAccessHotel(request.resource.data.hotelId)
        );

      allow update: if (
          isManager()
          && sameHotel(resource.data.hotelId)
          && sameIncomingHotel(request.resource.data.hotelId)
          && hotelIdUnchanged()
        ) || (
          isOwner()
          && ownerCanAccessHotel(resource.data.hotelId)
          && hotelIdUnchanged()
        );

      allow delete: if (
          isManager() && sameHotel(resource.data.hotelId)
        ) || (
          isOwner() && ownerCanAccessHotel(resource.data.hotelId)
        );
    }
    // -----------------------------------------------------------------------

    match /income/{documentId} {
      allow read: if canReadHotel(resource.data.hotelId);

      allow create: if (
          isManager()
          && sameIncomingHotel(request.resource.data.hotelId)
        ) || validStaffBookingIncome(request.resource.data)
          || validRestaurantIncome(request.resource.data);

      allow update: if (
          isManager()
          && sameHotel(resource.data.hotelId)
          && sameIncomingHotel(request.resource.data.hotelId)
          && hotelIdUnchanged()
        ) || (
          sameHotel(resource.data.hotelId)
          && hotelIdUnchanged()
          && request.resource.data.bookingId == resource.data.bookingId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["amount", "date", "description"])
          && validStaffBookingIncome(request.resource.data)
        ) || (
          sameHotel(resource.data.hotelId)
          && hotelIdUnchanged()
          && validRestaurantIncome(request.resource.data)
        );

      allow delete: if (
          isManager() && sameHotel(resource.data.hotelId)
        ) || staffCanDeleteBookingIncome()
          || staffOrManagerCanDeleteRestaurantIncome();
    }

    // --- B03 FIX ------------------------------------------------------------
    // Restaurant orders were missing from the allowlist, so the default rule
    // (deny) blocked all reads/writes and broke the whole Restaurant feature.
    // Restaurant behaves like other hotel data: hotel-scoped, Manager/Staff
    // can create/update/delete, Owner can read. hotelId cannot be changed.
    match /restaurantOrders/{documentId} {
      allow read:   if canReadHotel(resource.data.hotelId);
      allow create: if canCreateHotelDocument();
      allow update: if canUpdateHotelDocument();
      allow delete: if canDeleteHotelDocument();
    }
    // -----------------------------------------------------------------------

    match /complaints/{documentId} {
      allow read: if canReadHotel(resource.data.hotelId);
      allow create: if canCreateHotelDocument();
      allow update: if canUpdateHotelDocument()
        || (
          ownerCanAccessHotel(resource.data.hotelId)
          && hotelIdUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["replies", "updatedAt"])
        );
      allow delete: if canDeleteHotelDocument();
    }

    match /alerts/{documentId} {
      allow read: if canReadHotel(resource.data.hotelId);
      allow create: if canCreateHotelDocument()
        || (
          isOwner()
          && ownerCanAccessHotel(request.resource.data.hotelId)
        );
      allow update: if canUpdateHotelDocument();
      allow delete: if canDeleteHotelDocument();
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
          "rooms",
          "bookings",
          "expenses",
          "staff",
          "attendance",
          "suppliers",
          "inventory",
          "maintenance",
          "buffetItems",
          "announcements"
        ]
        && canReadHotel(resource.data.hotelId);

      allow create: if collectionName in [
          "rooms",
          "bookings",
          "expenses",
          "staff",
          "attendance",
          "suppliers",
          "inventory",
          "maintenance",
          "buffetItems",
          "announcements"
        ]
        && canCreateHotelDocument();

      allow update: if collectionName in [
          "rooms",
          "bookings",
          "expenses",
          "staff",
          "attendance",
          "suppliers",
          "inventory",
          "maintenance",
          "buffetItems",
          "announcements"
        ]
        && canUpdateHotelDocument();

      allow delete: if collectionName in [
          "rooms",
          "bookings",
          "expenses",
          "staff",
          "attendance",
          "suppliers",
          "inventory",
          "maintenance",
          "buffetItems",
          "announcements"
        ]
        && canDeleteHotelDocument();
    }

    match /credentialUsernames/{documentId} {
      allow read, write: if false;
    }

    match /credentialPasswords/{documentId} {
      allow read, write: if false;
    }

    match /test/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
